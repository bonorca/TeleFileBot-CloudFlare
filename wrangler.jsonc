{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "telefilebot-cloudflare",
	"main": "src/index.js",
	"compatibility_date": "2025-01-01",
	"observability": {
		"enabled": true,
	},
	"compatibility_flags": ["nodejs_compat"],
	// Workers AI, used to auto-classify uploaded files
	"ai": {
		"binding": "AI",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "telefilebot-cloudflare-db",
			"database_id": "YOUR_DATABASE_ID_HERE",
		},
	],
	// Secrets (set via `wrangler secret put`):
	//   BOT_TOKEN   - Telegram bot token from @BotFather
	//   BOT_SECRET  - Random string for webhook URL verification
	//   CHANNEL_ID  - Private Telegram channel ID (e.g. -100xxxxxxxxxx)
	//   ADMIN_ID    - Your Telegram user ID
}

{
	"name": "telefilebot-cloudflare",
	"version": "1.0.0",
	"description": "A personal file storage bot for Telegram, powered by Cloudflare Workers + D1",
	"main": "src/index.js",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:init": "wrangler d1 execute telefilebot-cloudflare-db --file=schema.sql --remote",
		"db:migrate": "wrangler d1 execute telefilebot-cloudflare-db --file=migrations/0001_add_category.sql --remote",
		"db:migrate:2": "wrangler d1 execute telefilebot-cloudflare-db --file=migrations/0002_media_groups.sql --remote",
		"db:migrate:3": "wrangler d1 execute telefilebot-cloudflare-db --file=migrations/0003_settings.sql --remote",
		"webhook:register": "echo 'Visit https://YOUR_WORKER.workers.dev/registerWebhook'",
		"webhook:unregister": "echo 'Visit https://YOUR_WORKER.workers.dev/unregisterWebhook'",
		"logs": "wrangler tail"
	},
	"keywords": [
		"telegram",
		"bot",
		"file-storage",
		"cloudflare-workers",
		"d1",
		"backup",
		"serverless"
	],
	"license": "MIT",
	"devDependencies": {
		"wrangler": "^4.0.0"
	}
}
